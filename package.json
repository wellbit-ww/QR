{
  "name": "equipment-support-mvp",
  "version": "1.0.0",
  "description": "MVP веб-приложения для производственного оборудования",
  "main": "server.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node scripts/start-portal.js",
    "dev": "nodemon server.js",
    "docker:db": "docker compose up -d",
    "stack:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-equipment-stack.ps1",
    "stack:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-equipment-stack.ps1",
    "eval:sdb1560m:phase6-tail": "node scripts/eval-sdb1560m-phase6-tail.js",
    "ingest:knowledge": "node scripts/ingest-knowledge.js",
    "eval:rag": "node scripts/eval-rag.js",
    "eval:sdb702nm": "set EVAL_DATASET=data\\eval-sdb702nm-rag.json&& node scripts/eval-rag.js",
    "eval:sdb702nm:coverage": "set EVAL_DATASET=data\\eval-sdb702nm-manual-coverage.json&& node scripts/eval-rag.js",
    "eval:sdb702nm:chatgpt": "set EVAL_AUTO_LOGIN=1&& set EVAL_BASE_URL=http://127.0.0.1:3000&& set EVAL_DATASET=data\\eval-sdb702nm-chatgpt-suite.json&& node scripts/eval-rag.js",
    "eval:parity": "node scripts/eval-sdb1106nm-parity.js",
    "validate:parity-json": "node scripts/validate-eval-parity-json.js",
    "test:golden-router": "node scripts/test-sdb1106nm-golden-router.js",
    "test:golden-router-paraphrase": "node scripts/test-sdb1106nm-golden-router-paraphrase.js",
    "test:golden-router-coverage": "node scripts/test-sdb1106nm-golden-router-coverage.js",
    "report:supported-questions": "node scripts/run-supported-questions-report.js",
    "report:sdb702nm-supported-questions": "node scripts/run-sdb702nm-supported-questions-report.js",
    "report:sdb702nm-deterministic-paraphrases": "node scripts/run-sdb702nm-deterministic-paraphrase-report.js",
    "test:sdb1106nm": "node scripts/run-sdb1106nm-eval-suite.js",
    "test:sdb702nm": "node scripts/test-sdb702nm-profile.js",
    "test:sdb702nm:coverage": "node scripts/run-sdb702nm-eval-suite.js",
    "test:sdb1560m": "node scripts/test-sdb1560m-profile.js",
    "test:sdb1560m:honest-smoke": "node scripts/test-sdb1560m-honest-smoke.js",
    "test:sdb1560m:honest-smoke:ci": "node scripts/test-sdb1560m-honest-smoke-ci.js",
    "uat:sdb1560m:api": "node scripts/sdb1560m-uat-api-check.js",
    "eval:sdb1560m:cards": "set EVAL_AUTO_LOGIN=1&& set EVAL_BASE_URL=http://127.0.0.1:3000&& set EVAL_DATASET=data\\eval-sdb1560m-cards-wave.json&& node scripts/eval-rag.js",
    "test:sdb302nm": "node scripts/test-sdb302nm-profile.js",
    "test:sdb302nm:coverage": "node scripts/run-sdb302nm-eval-suite.js",
    "eval:sdb302nm": "set EVAL_DATASET=data\\eval-sdb302nm-rag.json&& node scripts/eval-rag.js",
    "test:sdb151nm": "node scripts/test-sdb151nm-profile.js",
    "test:sdb151nm:coverage": "node scripts/run-sdb151nm-eval-suite.js",
    "eval:sdb151nm": "set EVAL_DATASET=data\\eval-sdb151nm-rag.json&& node scripts/eval-rag.js",
    "eval:manual-docx": "node scripts/run-manual-docx-rag-test.js",
    "eval:new-batch": "node scripts/run-manual-docx-rag-test.js --dataset data/eval-new-batch-rag.json",
    "eval:human-style": "node scripts/run-manual-docx-rag-test.js --dataset data/eval-human-style-rag.json --report-md data/eval-human-style-rag-report.md",
    "eval:objective": "node scripts/run-manual-docx-rag-test.js --dataset data/eval-objective-benchmark-rag.json --report-md data/eval-objective-benchmark-rag-report.md",
    "eval:expert-traps": "node scripts/run-manual-docx-rag-test.js --dataset data/eval-expert-traps-rag.json --report-md data/eval-expert-traps-rag-report.md",
    "eval:rag-procedural": "node scripts/run-manual-docx-rag-test.js --dataset data/eval-rag-procedural-rag.json --report-md data/eval-rag-procedural-rag-report.md",
    "eval:adhoc": "node scripts/run-manual-docx-rag-test.js --dataset data/eval-adhoc-rag.json",
    "eval:adhoc-paraphrase": "node scripts/run-manual-docx-rag-test.js --dataset data/eval-adhoc-paraphrase-rag.json",
    "eval:sdb1106nm": "node scripts/run-sdb1106nm-eval-suite.js --live",
    "debug:rag": "node scripts/debug-rag-pipeline.js",
    "test:gate": "node scripts/test-sdb1106nm-gate.js --api http://127.0.0.1:3000",
    "user:create": "node scripts/create-portal-user.js",
    "user:menu": "node scripts/portal-accounts-menu.js",
    "user:app": "python scripts/portal-admin-gui.py",
    "sticker:generate": "python scripts/generate-portal-sticker.py",
    "test:portal-auth": "node scripts/test-portal-auth.js"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dompurify": "^3.4.12",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "undici": "^8.6.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
