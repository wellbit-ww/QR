# Скопируйте в .env (server.js и скрипты аккаунтов читают .env при старте):
#   copy .env.example .env

POSTGRES_URL=postgresql://rag:rag_secret_change_me@127.0.0.1:5432/equipment_rag
SESSION_SECRET=change_me_to_random_string_at_least_32_chars
AUTH_REQUIRED=1
# Таймаут сессии при бездействии (мс). Cookie продлевается при каждом запросе (rolling).
# По умолчанию 30 минут. Пример: 1800000
# SESSION_MAX_AGE_MS=1800000

# Production checklist:
# NODE_ENV=production
# HOST=127.0.0.1
# TRUST_PROXY=1
# Включайте только за Nginx на этом же сервере: Nginx обязан сам задавать
# X-Forwarded-For и не пропускать одноимённый заголовок от клиента.
# SESSION_COOKIE_SECURE=1
# CHAT_LOG_FILE=0
# В production замените POSTGRES_URL и SESSION_SECRET на уникальные значения.
# Сервер откажется стартовать с AUTH_REQUIRED=0 или placeholder-секретами.

# Для npm run eval:* при включённом входе:
# EVAL_LOGIN=sovt01
# EVAL_PASSWORD=your_password

# Лимит длины ответа Ollama (токены). Для «купил шкаф / как запустить» — OLLAMA_GETTING_STARTED_PREDICT
# OLLAMA_PROCEDURAL_PREDICT=1024
# OLLAMA_GETTING_STARTED_PREDICT=1280

# Форма техподдержки → info@sovtest-ate.ru, service@sovtest-ate.ru, dalutin@sovtest-ate.ru
# Организация в форме — из поля label учётной записи (npm run user:menu)
# Тот же SMTP, что и сброс пароля на sovai.tech:
SMTP_HOST=mail.sovtest-ate.com
SMTP_PORT=25
SMTP_FROM=SOVA <sovai@sovtest-ate.com>
# Если сервер требует логин (раскомментируйте):
# SMTP_USER=sovai
# SMTP_PASS=your_password
